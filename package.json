  "description": "Realtime Stockbit stock data scraper using Playwright with stealth, cookie-based sessions, and XHR/WebSocket interception.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "scrape": "node index.js",
    "clear-session": "node tools/clearSession.js",
    "show": "node tools/showLatest.js",
    "show:json": "node tools/showLatest.js --json",
    "show:top": "node tools/showLatest.js --top 20",
    "pm2:start": "pm2 start index.js --name stock-bot",
