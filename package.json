{
  "name": "stockbot",
  "version": "1.0.0",
  "description": "Telegram bot for IDX stock screening: rule-based technical analysis, calibrated ML timing gate, optional AI narration.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "show": "node tools/showLatest.js",
    "show:json": "node tools/showLatest.js --json",
    "show:top": "node tools/showLatest.js --top 20",
    "pm2:start": "pm2 start index.js --name stock-bot",
    "pm2:stop": "pm2 stop stock-bot",
    "pm2:logs": "pm2 logs stock-bot",
    "pm2:status": "pm2 status stock-bot",
    "backtest": "node src/eval/backtest.js",
    "report": "node src/eval/report.js",
    "train": "node src/eval/train.js"
  },
  "keywords": [
    "idx",
    "saham",
    "telegram",
    "stock",
    "technical-analysis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-telegram-bot-api": "^0.67.0",
    "technicalindicators": "^3.1.0",
    "winston": "^3.13.0",
    "yahoo-finance2": "^3.14.0"
  }
}
