# Stockbit Credentials
STOCKBIT_EMAIL=your_email@example.com
STOCKBIT_PASSWORD=your_password

# Bot Config
HEADLESS=false
MAX_RETRIES=3
REQUEST_DELAY_MIN=1000
REQUEST_DELAY_MAX=5000
OUTPUT_DIR=./output
COOKIES_FILE=./cookies/session.json

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Telegram Config
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat id from @userinfobot or similar
TELEGRAM_CHAT_ID=your_chat_id_here
