# Telegram Config
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat id from @userinfobot or similar
TELEGRAM_CHAT_ID=your_chat_id_here

# Universe
# Comma-separated tickers (BBCA.JK,ANTM.JK) or ALL for the full IDX list
STOCK_SYMBOLS=ALL
# Skip stocks priced above this (IDR)
MAX_STOCK_PRICE=500
MAX_RETRIES=3

# Output / logging
OUTPUT_DIR=./output
LOG_LEVEL=info
LOG_DIR=./logs

# Yahoo Finance cache TTL in hours (default 6)
CACHE_TTL_HOURS=6

# Generative AI — optional advisory layer (sentiment + narration).
# Leave AI_API_KEY empty to disable; the bot behaves identically without it.
# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, Groq, OpenRouter, 9Router).
AI_API_KEY=
AI_BASE_URL=https://9router.tefambo.site/v1
AI_MODEL=Hermes-Combo
# Hard timeout per AI call in ms
AI_TIMEOUT_MS=25000
# Set to false to disable the whole advisory layer without removing the key
AI_ENABLED=true

# News cache (Google News RSS)
NEWS_TTL_HOURS=6
NEWS_MAX_AGE_DAYS=10
